# Carpeta de salida. Sin esta linea se usa el default ~/Music/dsound
# (en Windows: C:\Users\<tu_usuario>\Music\dsound).
# OUTPUT_DIR=C:\Users\<tu_usuario>\Music\dsound
MP3_BITRATE=320
# DSOUND_PORT=5000

# Descomentar para poder abrir dsound desde otro dispositivo de tu red (celular, etc).
# OJO: sin DSOUND_PASSWORD (abajo), cualquiera en tu misma red (WiFi/LAN)
# puede ver, bajar y borrar tu biblioteca.
# DSOUND_HOST=0.0.0.0
# ...y con esto los otros dispositivos tienen que loguearse (esta PC no):
# DSOUND_PASSWORD=una-contraseña-larga

# Buscar artista/titulo/album oficiales en YouTube Music al bajar temas sueltos (1 = si, 0 = no)
# DSOUND_MUSIC_METADATA=1

# Donde guarda dsound la cola de descargas y la sesion (default: ~/.dsound)
# DSOUND_DATA_DIR=

# No abrir el navegador al arrancar
# DSOUND_NO_BROWSER=1