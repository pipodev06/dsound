OUTPUT_DIR=downloads
# Windows: dejar vacio/borrar esta linea usa el default C:\Users\<tu_usuario>\Music\dsound
MP3_BITRATE=320
# DSOUND_PORT=5000

# Descomentar para poder abrir dsound desde otro dispositivo de tu red (celular, etc).
# OJO: dsound no tiene login ni password — con esto activado, cualquiera en tu
# misma red (WiFi/LAN) puede ver, bajar y borrar tu biblioteca. Dejar comentado
# (o en 127.0.0.1) si no confias en todos los dispositivos de tu red.
# DSOUND_HOST=0.0.0.0