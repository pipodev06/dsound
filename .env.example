# Copia este archivo como .env (en la carpeta de dsound.exe si usas el
# instalador o la versión portable) y quita el # de lo que quieras cambiar.

# Carpeta de salida. Sin esta línea se usa ~/Music/dsound
# (en Windows: C:\Users\<tu_usuario>\Music\dsound).
# OUTPUT_DIR=C:\Users\<tu_usuario>\Music\dsound
MP3_BITRATE=320
# DSOUND_PORT=5000

# Para abrir dsound desde otro dispositivo de tu red (celular, etc.).
# ATENCIÓN: sin DSOUND_PASSWORD, cualquier persona en tu red (wifi/LAN)
# puede ver, descargar y borrar tu biblioteca.
# DSOUND_HOST=0.0.0.0
# Con esto los otros dispositivos tienen que iniciar sesión (esta PC no):
# DSOUND_PASSWORD=una-contraseña-larga

# Navegador del que se toman las cookies de YouTube (soluciona el error
# "confirma que no eres un bot"): firefox, chrome, edge, brave, opera, vivaldi
# o chromium. También se cambia desde Ajustes.
# DSOUND_COOKIES_BROWSER=firefox

# Buscar artista/título/álbum oficiales en YouTube Music (1 = sí, 0 = no)
# DSOUND_MUSIC_METADATA=1

# Avisar cuando hay una versión nueva de dsound (1 = sí, 0 = no)
# DSOUND_UPDATE_CHECK=1

# No abrir el navegador al iniciar / no mostrar el ícono junto al reloj
# DSOUND_NO_BROWSER=1
# DSOUND_NO_TRAY=1

# Dónde guarda dsound la cola, la sesión y el registro (por defecto ~/.dsound)
# DSOUND_DATA_DIR=
